# Copy to .env and fill in. Never commit .env.

# --- Generic hosted API backend (renderers/api.py) --------------------
# Set renderer.backend: api in config/studio.yaml to use these.
OCTAVIA_API_ENDPOINT=
OCTAVIA_API_KEY=

# --- ComfyUI backend (renderers/comfyui.py) ---------------------------
# Host and port normally live in config/studio.yaml; override here if you
# run ComfyUI on another machine.
# OCTAVIA_COMFYUI_HOST=127.0.0.1
# OCTAVIA_COMFYUI_PORT=8188
